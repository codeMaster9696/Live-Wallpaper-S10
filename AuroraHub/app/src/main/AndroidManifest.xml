<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================
   AuroraHub · Live Wallpaper Hub
   Manifesto: atividade de galeria, atividade de ajustes e o serviço de
   papel de parede ao vivo (WallpaperService).

   Pontos críticos:
   1. android:permission="android.permission.BIND_WALLPAPER" no serviço.
      Sem isso o sistema RECUSA o bind e o wallpaper nunca aparece.
   2. android:exported="true" no serviço (Android 12+ exige declaração
      explícita quando há intent-filter).
   3. meta-data android.service.wallpaper apontando para res/xml/wallpaper.xml
      (thumbnail, descrição e settingsActivity exibidos pelo sistema).
  =====================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declarar o recurso evita que o app seja filtrado em dispositivos
         sem suporte a live wallpaper (e documenta a dependência). -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

  <uses-permission 
    android:name="android.permission.READ_EXTERNAL_STORAGE" />
  
    <!-- OpenGL ES 2.0: usado pelo renderizador EGL/GLES do Engine. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Necessária para WallpaperManager.setWallpaperComponent() e para
         definir o wallpaper estático de fallback. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />

    <!-- Opcional: vídeos escolhidos pelo usuário fora de assets/.
         Em Android 13+ o acesso é granular por tipo de mídia. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- O serviço de wallpaper NÃO precisa de foreground service,
         INTERNET, WAKE_LOCK ou BOOT_COMPLETED. Nada disso é declarado:
         menos permissões = menos atrito na One UI. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:theme="@style/Theme.AuroraHub"
        tools:targetApi="34">

        <!-- ================= GALERIA (launcher) ================= -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.AuroraHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= AJUSTES =================
             Exported porque quem abre esta Activity é o processo do
             sistema (Settings > Papel de parede > ⚙). -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:parentActivityName=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/settings_title"
            android:theme="@style/Theme.AuroraHub" />

        <!-- ================= LIVE WALLPAPER ================= -->
        <service
            android:name=".service.HubWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>
</manifest>
